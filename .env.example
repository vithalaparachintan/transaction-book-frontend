# ⛔ FRONTEND ENVIRONMENT - REFERENCE ONLY
# DO NOT ADD REAL SECRETS HERE!
# No real secrets should be in frontend .env

# API Configuration
# Local Development:
REACT_APP_API_URL=http://localhost:5000/api
# Production (Render):
# REACT_APP_API_URL=https://your-backend-url.onrender.com/api

# Razorpay Public Key (This is OK to expose - it's public)
# Get from: https://dashboard.razorpay.com/app/keys
REACT_APP_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxx

# App Configuration
REACT_APP_NAME=Transaction Book
REACT_APP_VERSION=1.0.0
