# ⛔ FRONTEND ENVIRONMENT - REFERENCE ONLY
# DO NOT ADD REAL SECRETS HERE!
# No real secrets should be in frontend .env
# NOTE: Vite uses VITE_ prefix for environment variables

# API Configuration
# Local Development:
VITE_API_URL=http://localhost:5000/api
# Production (Render):
# VITE_API_URL=https://your-backend-url.onrender.com/api

# Razorpay Public Key (This is OK to expose - it's public)
# Get from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxx

# App Configuration
VITE_APP_NAME=Transaction Book
VITE_APP_VERSION=1.0.0
